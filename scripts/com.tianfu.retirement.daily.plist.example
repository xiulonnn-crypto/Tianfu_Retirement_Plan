<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.tianfu.retirement.daily</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>REPLACE_WITH_ABSOLUTE_PROJECT_PATH/scripts/daily-update.sh</string></array>
<key>StandardOutPath</key><string>REPLACE_WITH_ABSOLUTE_PROJECT_PATH/data/launch.out.log</string>
<key>StandardErrorPath</key><string>REPLACE_WITH_ABSOLUTE_PROJECT_PATH/data/launch.err.log</string>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
<key>RunAtLoad</key><true/>
</dict></plist>
